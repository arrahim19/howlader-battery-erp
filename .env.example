# Copy with npm run setup; never commit the resulting .env.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# Optional development-only LAN access; keep the origin and port exact.
# APP_DEV_ORIGINS=http://192.168.68.79:3000
API_PORT=3001
INTERNAL_API_URL=http://127.0.0.1:3001
DATABASE_URL=postgresql://hawlader:CHANGE_ME@127.0.0.1:55432/hawlader_erp?schema=public
# PC-hosted setup: npm run setup:local-first creates a separate PostgreSQL cluster
# at 127.0.0.1:55433 and replaces these URLs without importing sample transactions.
CSRF_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
# Email login verification and password recovery. For Gmail use a Google App Password.
# Never use your normal Gmail password or commit SMTP_PASSWORD.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_FROM=you@gmail.com
# SMTP_PASSWORD=your_16_character_app_password
# Optional: path containing initdb/pg_ctl (PostgreSQL 18), used by npm run db:local.
# PG_BIN_DIR=C:/Program Files/PostgreSQL/18/bin

# Owner-managed encrypted Google Drive backups. See docs/LOCAL_FIRST.md.
BACKUP_ENABLED=false
# BACKUP_ENCRYPTION_KEY=<64 random hexadecimal characters; keep an offline copy>
# BACKUP_OWNER_USER_ID=<your public-shop User UUID; other shop owners cannot manage Drive>
# BACKUP_DIRECTORY=F:/private/erp-backups
# GOOGLE_DRIVE_CLIENT_ID=<Web OAuth client ID>
# GOOGLE_DRIVE_CLIENT_SECRET=<Web OAuth client secret>
# GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/v1/backups/google/callback

# Serverless Apps Script sync (current design; independent of the PC API URL).
# GOOGLE_APPS_SCRIPT_SYNC_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT/exec
