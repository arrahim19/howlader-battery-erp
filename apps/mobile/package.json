{
  "name": "@hawlader/mobile",
  "version": "1.0.10",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/hashes": "1.8.0",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.14",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "typecheck": "node --stack-size=8192 node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint src app.config.ts",
    "export:android": "expo export --platform android",
    "build:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build-android-local.ps1",
    "build:stable": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build-android-local.ps1 -Variant stable",
    "build:apk:cloud": "npx --yes eas-cli@latest build --platform android --profile preview",
    "start": "expo start --go --lan",
    "android": "expo start --go --lan",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  }
}
